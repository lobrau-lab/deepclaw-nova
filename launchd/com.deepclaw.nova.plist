<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.deepclaw.nova</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/SHARED_PLACEHOLDER/.deepclaw/nova.py</string>
        <string>live</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/deepclaw-nova.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/deepclaw-nova.err.log</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
